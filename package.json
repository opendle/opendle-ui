{
  "name": "@opendle/ui",
  "version": "0.1.0",
  "description": "Shared React design system and frontend primitives for OpenDLE projects.",
  "type": "module",
  "files": [
    "dist",
    "styles",
    "scripts",
    "README.md",
    "LICENSE.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./styles/tokens.css",
    "./scripts/build-consumer.mjs": "./scripts/build-consumer.mjs",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": "24.17.0",
    "npm": ">=11.0.0 <12.0.0"
  },
  "packageManager": "npm@11.18.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tubededentifrice/opendle-ui.git"
  },
  "license": "FSL-1.1-ALv2",
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "format": "prettier --write src test styles scripts/*.mjs scripts/tests/fixtures/*.json eslint.config.mjs package.json react-doctor.config.json renovate.json tsconfig.json tsconfig.build.json",
    "format:check": "prettier --check src test styles scripts/*.mjs scripts/tests/fixtures/*.json eslint.config.mjs package.json react-doctor.config.json renovate.json tsconfig.json tsconfig.build.json",
    "lint": "eslint src --max-warnings 0",
    "prepare": "npm run build",
    "react-doctor": "react-doctor . --json --json-compact --full --fail-on none",
    "security": "npm audit --audit-level=high",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.6",
    "react": "19.2.8",
    "react-doctor": "0.2.3",
    "react-dom": "19.2.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0"
  }
}
