{
  "name": "@opendle/ui",
  "version": "0.1.0",
  "description": "Shared React design system and frontend primitives for OpenDLE projects.",
  "type": "module",
  "files": ["dist", "styles", "README.md", "LICENSE.md"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./styles/tokens.css",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.0.0 <25.0.0",
    "npm": ">=11.0.0"
  },
  "packageManager": "npm@11.18.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tubededentifrice/opendle-ui.git"
  },
  "license": "FSL-1.1-ALv2",
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  }
}
